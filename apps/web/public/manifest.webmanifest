{
  "name": "MinimalERP",
  "short_name": "MinimalERP",
  "description": "Keyboard-first accounting and inventory",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "files", "accept": ["application/pdf", "image/png", "image/jpeg", "image/webp", "image/heic", "image/heif"] }
      ]
    }
  },
  "orientation": "any",
  "background_color": "#f6f5f1",
  "theme_color": "#0b5cad",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
